# ==============================================================================
# Sovereign Agentic Context Protocol (SACP) v0.2 - Environment Configuration
# ==============================================================================

# 1. Account Aggregator RSA Public Key (PEM format)
# Used to verify RS256 JWS and Detached JWS (x-jws-signature) on ReBIT v2.0+ consent artefacts.
# If unset, SACP auto-generates ephemeral in-memory dev keys on startup.
AA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# 2. FIU Curve25519 (X25519) Private Key (PEM format)
# Used for ReBIT forward-secrecy ECDH key agreement with FIP ephemeral keys.
# If unset, SACP auto-generates an ephemeral dev keypair on startup.
FIU_X25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VuBCIEI...\n-----END PRIVATE KEY-----"

# 3. Ephemeral Financial Information Decryption Key (Fernet legacy mock fallback)
# 32-byte url-safe base64 Fernet key used for strictly in-RAM mock payload decryption.
FI_DECRYPTION_KEY="sample_base64_32_byte_fernet_key_here="

# 4. API Gateway Authentication Key
# Bearer token required for all HTTP requests to /mcp (AA webhooks are exempted).
# If unset in development, SACP logs a security warning and allows unauthenticated testing.
SACP_CLIENT_API_KEY="sacp-live-api-key-replace-in-production"

# 5. Sahamati / Account Aggregator Sandbox Configuration
AA_SANDBOX_BASE_URL="https://api-sandbox.sahamati.org.in"
AA_ENTITY_ID="AA-SANDBOX"
FIU_ENTITY_ID="SACP-FIU-APP"

# 6. DPDP Tamper-Evident Audit Ledger Database URL
# Default fallback: SQLite file database (sqlite:///./sacp_audit.db) or in-memory (sqlite:///:memory:)
# Production: Managed PostgreSQL (e.g. Supabase Mumbai ap-south-1 transaction pooled connection)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
